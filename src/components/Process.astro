---
import { useTranslations, type Locale, type UIKey } from "../i18n/ui";
import { emblemStageSVG } from "../lib/emblem";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const steps = [1, 2, 3, 4, 5, 6, 7].map((n) => ({
  n,
  title: t(`process.${n}.title` as UIKey),
  body: t(`process.${n}.body` as UIKey),
  glyph: emblemStageSVG(n),
}));
---

<section class="process" id="process" aria-labelledby="process-title" data-process>
  <div class="container grid">
    <header class="head">
      <p class="eyebrow">{t("process.eyebrow")}</p>
      <h2 id="process-title">{t("process.title")}</h2>
    </header>

    <ol class="steps" data-steps>
      {
        steps.map((s) => (
          <li class="step" data-step style={`--n:${s.n}`}>
            <span class="glyph" set:html={s.glyph} />
            <span class="num">{String(s.n).padStart(2, "0")}</span>
            <div class="text">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  // Progressive enhancement: everything is visible without this script.
  // With it, each glyph draws itself in when its step scrolls into view, the step at
  // the centre of the screen is highlighted, and an emerald line grows down the steps.
  const section = document.querySelector<HTMLElement>("[data-process]");
  const list = document.querySelector<HTMLElement>("[data-steps]");
  const steps = document.querySelectorAll<HTMLElement>("[data-step]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (section && list && "IntersectionObserver" in window && !reduce) {
    section.setAttribute("data-animate", "");
    const seen = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.setAttribute("data-seen", "");
            seen.unobserve(e.target);
          }
        }),
      { rootMargin: "0px 0px -15% 0px" },
    );
    const current = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.toggleAttribute("data-current", e.isIntersecting)),
      { rootMargin: "-45% 0px -45% 0px" },
    );
    steps.forEach((s) => {
      seen.observe(s);
      current.observe(s);
    });
    let raf = 0;
    const progress = () => {
      raf = 0;
      const r = list.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.5 - r.top) / r.height));
      list.style.setProperty("--progress", p.toFixed(3));
    };
    window.addEventListener("scroll", () => (raf ||= requestAnimationFrame(progress)), { passive: true });
    progress();
  }
</script>

<style>
  .process {
    padding-block: var(--s-24);
    border-top: 1px solid var(--line);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-16);
    align-items: start;
  }
  .head {
    position: sticky;
    top: calc(var(--header-h) + var(--s-8));
    display: grid;
    gap: var(--s-4);
  }
  h2 {
    font-size: var(--step-3);
    font-weight: 600;
    color: var(--text-strong);
    max-width: 14ch;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .steps::before {
    /* the line that connects the glyphs */
    content: "";
    position: absolute;
    left: 32px;
    top: 32px;
    bottom: 32px;
    width: 1px;
    background: var(--line-strong);
  }
  .steps::after {
    /* emerald progress line, grown by the scroll script */
    content: "";
    position: absolute;
    left: 32px;
    top: 32px;
    bottom: 32px;
    width: 1px;
    background: var(--accent);
    transform-origin: top;
    transform: scaleY(var(--progress, 0));
    z-index: 0;
  }
  .step {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 64px 2.5rem minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
    padding-block: var(--s-6);
  }
  .glyph {
    position: relative;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--bg);
    display: grid;
    place-items: center;
  }
  .glyph :global(svg) {
    width: 52px;
    height: 52px;
  }
  .glyph :global(.g-line) {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 6;
    stroke-linejoin: round;
  }
  .glyph :global(.g-node) {
    fill: var(--text);
  }
  .glyph :global(.g-seed) {
    fill: var(--accent);
  }
  .glyph :global(.g-plane) {
    fill: var(--text);
    opacity: 0.08;
  }
  .glyph :global(.g-core) {
    fill: var(--text);
    opacity: 0.45;
  }
  .glyph :global(.g-core-top) {
    opacity: 0.8;
  }
  .glyph :global(.g-core-low) {
    opacity: 0.3;
  }
  .step:last-child .glyph :global(.g-node) {
    fill: var(--accent);
  }
  .num {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text-muted);
    padding-top: 0.35em;
    font-variant-numeric: tabular-nums;
  }
  .text {
    display: grid;
    gap: var(--s-1);
  }
  h3 {
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--text-strong);
  }
  .text p {
    color: var(--text-muted);
  }
  .step .glyph,
  .step h3 {
    transition: transform var(--dur-slow) var(--ease), color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
  }
  .step[data-current] .glyph {
    transform: scale(1.12);
    box-shadow: 0 0 0 1px var(--accent), 0 0 24px var(--accent-soft);
  }
  .glyph :global(svg) {
    animation: float 6s ease-in-out infinite;
    animation-delay: calc(var(--n) * -0.8s);
    transition: transform var(--dur-slow) var(--ease);
  }
  .step:hover .glyph :global(svg) {
    transform: rotate(30deg) scale(1.05);
  }
  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -3px;
    }
  }

  /* Draw-in, only once the script has marked the section (so nothing is hidden without it). */
  .process[data-animate] .step:not([data-seen]) .glyph :global(.g-line) {
    stroke-dashoffset: 1;
  }
  .process[data-animate] .glyph :global(.g-line) {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 900ms var(--ease) calc(var(--i) * 40ms + 150ms);
  }
  .process[data-animate] .step:not([data-seen]) .glyph :global(.g-node) {
    transform: scale(0);
  }
  .process[data-animate] .glyph :global(.g-node) {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--i) * 70ms + 100ms);
  }
  .process[data-animate] .step:not([data-seen]) .glyph :global(.g-plane),
  .process[data-animate] .step:not([data-seen]) .glyph :global(.g-core) {
    opacity: 0;
  }
  .process[data-animate] .glyph :global(.g-plane),
  .process[data-animate] .glyph :global(.g-core) {
    transition: opacity 800ms var(--ease) 700ms;
  }
  .process[data-animate] .step:not([data-seen]) .text {
    opacity: 0;
    transform: translateY(10px);
  }
  .process[data-animate] .text {
    transition: opacity 700ms var(--ease) 200ms, transform 700ms var(--ease) 200ms;
  }
  .step[data-current] .num {
    color: var(--accent);
  }

  @media (max-width: 959px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
    .head {
      position: static;
    }
    .step {
      grid-template-columns: 64px minmax(0, 1fr);
    }
    .num {
      display: none;
    }

  }
</style>
