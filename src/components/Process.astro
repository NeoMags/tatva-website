---
import { useTranslations, type Locale, type UIKey } from "../i18n/ui";
import { emblemSVG, emblemStageSVG } from "../lib/emblem";
import Logo from "./Logo.astro";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const steps = [1, 2, 3, 4, 5, 6, 7, 8].map((n) => ({
  n,
  title: t(`process.${n}.title` as UIKey),
  body: t(`process.${n}.body` as UIKey),
  glyph: emblemStageSVG(n),
}));
const finaleEmblem = emblemSVG({ id: "finale-emblem" });
// Each sentence of the promise stays together on its own line where it fits.
const finaleSentences = t("process.finale.line").split(/(?<=[.।])\s+/);
---

<section class="process" id="process" aria-labelledby="process-title" data-process>
  <div class="container grid">
    <header class="head">
      <p class="eyebrow">{t("process.eyebrow")}</p>
      <h2 id="process-title">{t("process.title")}</h2>
    </header>

    <div class="flow">
    <ol class="steps" data-steps>
      {
        steps.map((s) => (
          <li class="step" data-step data-final={s.n === steps.length ? "" : undefined} style={`--n:${s.n}`}>
            <span class="glyph" set:html={s.glyph} />
            <span class="num">{String(s.n).padStart(2, "0")}</span>
            <div class="text">
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <!-- The outcome the eight steps lead to: the finished emblem, the name and the promise. -->
    <figure class="finale" data-finale aria-labelledby="finale-line">
      <span class="finale-label">{t("process.finale.label")}</span>
      <div class="finale-lockup">
        <span class="finale-emblem" set:html={finaleEmblem} />
        <Logo variant="wordmark" class="finale-word" id="finale-logo" />
        <span class="finale-tag">
          <span class="w">Build</span><span class="dot" aria-hidden="true"></span><span class="w">Connect</span><span
            class="dot"
            aria-hidden="true"></span><span class="w">Expand</span>
        </span>
      </div>
      <figcaption class="finale-text">
        <p id="finale-line" class="finale-line">
          {finaleSentences.map((line) => <span>{line} </span>)}
        </p>
      </figcaption>
    </figure>
    </div>
  </div>
</section>

<script>
  // Progressive enhancement: everything is visible without this script.
  // With it, each glyph draws itself in when its step scrolls into view, the step at
  // the centre of the screen is highlighted, and an emerald line grows down the steps.
  const section = document.querySelector<HTMLElement>("[data-process]");
  const list = document.querySelector<HTMLElement>("[data-steps]");
  const steps = document.querySelectorAll<HTMLElement>("[data-step]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (section && list && "IntersectionObserver" in window && !reduce) {
    section.setAttribute("data-animate", "");
    const seen = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.setAttribute("data-seen", "");
            seen.unobserve(e.target);
          }
        }),
      { rootMargin: "0px 0px -15% 0px" },
    );
    const current = new IntersectionObserver(
      (entries) => entries.forEach((e) => e.target.toggleAttribute("data-current", e.isIntersecting)),
      { rootMargin: "-45% 0px -45% 0px" },
    );
    steps.forEach((s) => {
      seen.observe(s);
      current.observe(s);
    });
    const finale = document.querySelector("[data-finale]");
    if (finale) seen.observe(finale);
    let raf = 0;
    const progress = () => {
      raf = 0;
      const r = list.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.5 - r.top) / r.height));
      list.style.setProperty("--progress", p.toFixed(3));
    };
    window.addEventListener("scroll", () => (raf ||= requestAnimationFrame(progress)), { passive: true });
    progress();
  }
</script>

<style>
  .process {
    padding-block: var(--s-24);
    border-top: 1px solid var(--line);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-16);
    align-items: start;
  }
  .head {
    position: sticky;
    top: calc(var(--header-h) + var(--s-8));
    display: grid;
    gap: var(--s-4);
  }
  h2 {
    font-size: var(--step-3);
    font-weight: 600;
    color: var(--text-strong);
    max-width: 14ch;
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
  }
  .steps::before {
    /* the line that connects the glyphs */
    content: "";
    position: absolute;
    left: 32px;
    top: 32px;
    bottom: calc(-1 * var(--s-12)); /* runs on into the finale card: every step leads there */
    width: 1px;
    background: var(--line-strong);
  }
  .steps::after {
    /* emerald progress line, grown by the scroll script */
    content: "";
    position: absolute;
    left: 32px;
    top: 32px;
    bottom: calc(-1 * var(--s-12));
    width: 1px;
    background: var(--accent);
    transform-origin: top;
    transform: scaleY(var(--progress, 0));
    z-index: 0;
  }
  .step {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 64px 2.5rem minmax(0, 1fr);
    gap: var(--s-4);
    align-items: start;
    padding-block: var(--s-6);
  }
  .glyph {
    position: relative;
    width: 64px;
    height: 64px;
    /* masks the connecting line behind the glyph; no visible shape of its own */
    background: var(--bg);
    display: grid;
    place-items: center;
  }
  .glyph :global(svg) {
    width: 52px;
    height: 52px;
  }
  .glyph :global(.g-line) {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 6;
    stroke-linejoin: round;
  }
  .glyph :global(.g-node) {
    fill: var(--text);
  }
  .glyph :global(.g-seed) {
    fill: var(--accent);
  }
  .glyph :global(.g-plane) {
    fill: var(--text);
    opacity: 0.08;
  }
  .glyph :global(.g-core) {
    fill: var(--text);
    opacity: 0.45;
  }
  .glyph :global(.g-core-top) {
    opacity: 0.8;
  }
  .glyph :global(.g-core-low) {
    opacity: 0.3;
  }
  /* Step 08: the finished emblem in its emerald variant, softly lit (no halo shape). */
  .glyph :global(.g-final .g-line) {
    stroke: var(--accent);
  }
  .glyph :global(.g-final .g-node) {
    fill: var(--accent);
  }
  .glyph :global(.g-final .g-plane) {
    fill: var(--accent);
    opacity: 0.14;
  }
  .glyph :global(.g-final .g-core) {
    fill: var(--accent);
  }
  .glyph :global(svg.g-final) {
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--accent) 55%, transparent));
  }
  .step[data-final] h3 {
    color: var(--accent);
  }

  /* Finale: the outcome every step leads to. A centred brand plate:
     label, emblem, wordmark, tagline, then the promise below a hairline. */
  .finale {
    margin: var(--s-12) 0 0;
    padding: var(--s-12) var(--s-8);
    display: grid;
    justify-items: center;
    gap: var(--s-8);
    text-align: center;
    border: 1px solid var(--line);
    background: radial-gradient(120% 90% at 50% 0%, var(--accent-soft), transparent 70%);
    /* the emblem in its emerald variant, following the theme's accent */
    --emblem-line: var(--accent);
    --emblem-node: var(--accent);
    --emblem-face-a: color-mix(in srgb, var(--accent) 22%, transparent);
    --emblem-face-b: color-mix(in srgb, var(--accent) 8%, transparent);
    --emblem-core-top: color-mix(in srgb, var(--accent) 70%, transparent);
    --emblem-core-side: color-mix(in srgb, var(--accent) 42%, transparent);
    --emblem-core-front: color-mix(in srgb, var(--accent) 26%, transparent);
    --track: 0.32em;
  }
  .finale-label {
    font-family: var(--font-display);
    font-size: var(--step--1);
    letter-spacing: 0.2em;
    /* cancel the trailing letter-space so the text is optically centred */
    margin-right: -0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .finale-lockup {
    display: grid;
    justify-items: center;
    gap: var(--s-4);
  }
  .finale-emblem {
    width: clamp(88px, 9vw, 120px);
    aspect-ratio: 1;
    display: block;
    margin-bottom: var(--s-2);
  }
  .finale-emblem :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
    filter: drop-shadow(0 0 14px color-mix(in srgb, var(--accent) 45%, transparent));
    animation: finale-float 6s ease-in-out infinite;
  }
  @keyframes finale-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -4px;
    }
  }
  .finale-lockup :global(.finale-word) {
    display: block;
    color: var(--text-strong);
    line-height: 0;
  }
  .finale-lockup :global(.finale-word .logo-word) {
    display: block;
    width: clamp(200px, 22vw, 280px);
    height: auto;
  }
  .finale-tag {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1em;
    font-family: var(--font-display);
    font-size: var(--step--1);
    color: var(--text);
    white-space: nowrap;
  }
  .finale-tag .w {
    letter-spacing: var(--track);
    margin-right: calc(-1 * var(--track)); /* no trailing space: dots sit exactly between words */
    text-transform: uppercase;
  }
  .finale-tag .dot {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }
  .finale-text {
    width: 100%;
    padding-top: var(--s-8);
    border-top: 1px solid var(--line);
    display: grid;
    justify-items: center;
  }
  .finale-line {
    margin: 0;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--text-strong);
    max-width: 34ch;
    text-wrap: balance;
  }
  .finale-line span {
    display: inline-block;
  }
  .process[data-animate] .finale:not([data-seen]) {
    opacity: 0;
    transform: translateY(16px);
  }
  .process[data-animate] .finale {
    transition: opacity 900ms var(--ease) 150ms, transform 900ms var(--ease) 150ms;
  }
  .num {
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text-muted);
    padding-top: 0.35em;
    font-variant-numeric: tabular-nums;
  }
  .text {
    display: grid;
    gap: var(--s-1);
  }
  h3 {
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--text-strong);
  }
  .text p {
    color: var(--text-muted);
  }
  .step .glyph,
  .step h3 {
    transition: transform var(--dur-slow) var(--ease), color var(--dur) var(--ease);
  }
  .step[data-current] .glyph {
    transform: scale(1.12);
  }
  .glyph :global(svg) {
    animation: float 6s ease-in-out infinite;
    animation-delay: calc(var(--n) * -0.8s);
    transition: transform var(--dur-slow) var(--ease);
  }
  .step:hover .glyph :global(svg) {
    transform: rotate(30deg) scale(1.05);
  }
  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -3px;
    }
  }

  /* Draw-in, only once the script has marked the section (so nothing is hidden without it). */
  .process[data-animate] .step:not([data-seen]) .glyph :global(.g-line) {
    stroke-dashoffset: 1;
  }
  .process[data-animate] .glyph :global(.g-line) {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 900ms var(--ease) calc(var(--i) * 40ms + 150ms);
  }
  .process[data-animate] .step:not([data-seen]) .glyph :global(.g-node) {
    transform: scale(0);
  }
  .process[data-animate] .glyph :global(.g-node) {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 500ms cubic-bezier(0.34, 1.56, 0.64, 1) calc(var(--i) * 70ms + 100ms);
  }
  .process[data-animate] .step:not([data-seen]) .glyph :global(.g-plane),
  .process[data-animate] .step:not([data-seen]) .glyph :global(.g-core) {
    opacity: 0;
  }
  .process[data-animate] .glyph :global(.g-plane),
  .process[data-animate] .glyph :global(.g-core) {
    transition: opacity 800ms var(--ease) 700ms;
  }
  .process[data-animate] .step:not([data-seen]) .text {
    opacity: 0;
    transform: translateY(10px);
  }
  .process[data-animate] .text {
    transition: opacity 700ms var(--ease) 200ms, transform 700ms var(--ease) 200ms;
  }
  .step[data-current] .num {
    color: var(--accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .finale-emblem :global(svg) {
      animation: none;
    }
  }

  @media (max-width: 959px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
    .head {
      position: static;
    }
    .step {
      grid-template-columns: 64px minmax(0, 1fr);
    }
    .num {
      display: none;
    }
    .finale {
      padding: var(--s-8) var(--s-4);
      gap: var(--s-6);
    }
    .finale-tag {
      font-size: 0.7rem;
      gap: 0.8em;
    }

  }
</style>
