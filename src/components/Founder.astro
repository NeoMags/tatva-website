---
/**
 * Founder: two sides of Nesar, the Architect (suit) and the Builder (casual),
 * standing in front of a slowly turning TATVA hexagon. The figures cross-fade on
 * their own every few seconds while in view, or when a side is chosen; both layers
 * move a little with the pointer at different depths.
 */
import { Image } from "astro:assets";
import architect from "../assets/founder/suit-studio-cut.png";
import builder from "../assets/founder/casual-cut.png";
import { site } from "../data/site";
import { emblemSVG } from "../lib/emblem";
import { useTranslations, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const emblem = emblemSVG({ id: "founder-emblem" });
const sides = [
  { id: "architect", img: architect, label: t("founder.architect"), caption: t("founder.architect.caption"), alt: t("founder.architect.alt") },
  { id: "builder", img: builder, label: t("founder.builder"), caption: t("founder.builder.caption"), alt: t("founder.builder.alt") },
];
---

<section class="founder" id="about" aria-labelledby="founder-title" data-founder>
  <div class="container grid">
    <div class="stage-wrap">
      <figure class="stage" data-stage data-side="architect">
        <div class="backdrop" data-depth="-1" aria-hidden="true">
          <span class="emblem" set:html={emblem} />
          <span class="halo"></span>
        </div>
        {
          sides.map((side, i) => (
            <div class="figure" data-figure={side.id} data-depth="1" aria-hidden={i === 0 ? undefined : "true"}>
              <Image
                src={side.img}
                alt={side.alt}
                widths={[320, 520]}
                sizes="(max-width: 959px) 60vw, 380px"
                loading="lazy"
                decoding="async"
              />
            </div>
          ))
        }
        <span class="floor" aria-hidden="true"></span>
      </figure>

      <div class="sides" role="group" aria-label={t("founder.sides")}>
        {
          sides.map((side, i) => (
            <button type="button" data-pick={side.id} aria-pressed={i === 0 ? "true" : "false"}>
              <span class="side-label">{side.label}</span>
              <span class="side-caption">{side.caption}</span>
            </button>
          ))
        }
      </div>
    </div>

    <div class="copy">
      <p class="eyebrow">{t("founder.eyebrow")}</p>
      <h2 id="founder-title">{t("founder.title")}</h2>
      <p class="name">
        <span>{site.founder}</span>
        <span class="role">{t("founder.role")}</span>
      </p>
      <div class="bio">
        <p>{t("founder.p1")}</p>
        <p>{t("founder.p2")}</p>
        <p>{t("founder.p3")}</p>
      </div>
      <blockquote class="motto">{t("founder.motto")}</blockquote>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector<HTMLElement>("[data-founder]");
  const stage = root?.querySelector<HTMLElement>("[data-stage]");
  const buttons = root ? Array.from(root.querySelectorAll<HTMLButtonElement>("[data-pick]")) : [];
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (root && stage) {
    let auto = !reduce;
    let timer = 0;
    const show = (side: string) => {
      stage.dataset.side = side;
      buttons.forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.pick === side)));
      stage.querySelectorAll<HTMLElement>("[data-figure]").forEach((f) => {
        if (f.dataset.figure === side) f.removeAttribute("aria-hidden");
        else f.setAttribute("aria-hidden", "true");
      });
    };
    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        auto = false; // the visitor chose; stop alternating
        clearInterval(timer);
        show(b.dataset.pick ?? "architect");
      }),
    );

    // Alternate gently while the section is on screen, until the visitor picks one.
    const cycle = () => show(stage.dataset.side === "architect" ? "builder" : "architect");
    new IntersectionObserver(
      ([entry]) => {
        clearInterval(timer);
        if (entry.isIntersecting && auto) timer = window.setInterval(cycle, 6500);
      },
      { threshold: 0.4 },
    ).observe(stage);
    stage.addEventListener("pointerenter", () => clearInterval(timer));
    stage.addEventListener("pointerleave", () => {
      if (auto) timer = window.setInterval(cycle, 6500);
    });

    // Depth: the figure and the emblem drift in opposite directions with the pointer.
    if (!reduce && window.matchMedia("(hover: hover)").matches) {
      const layers = Array.from(stage.querySelectorAll<HTMLElement>("[data-depth]"));
      let raf = 0;
      stage.addEventListener("pointermove", (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = stage.getBoundingClientRect();
          const x = (e.clientX - r.left) / r.width - 0.5;
          const y = (e.clientY - r.top) / r.height - 0.5;
          layers.forEach((l) => {
            const d = Number(l.dataset.depth);
            l.style.translate = `${(x * 14 * d).toFixed(1)}px ${(y * 8 * d).toFixed(1)}px`;
          });
        });
      });
      stage.addEventListener("pointerleave", () => layers.forEach((l) => (l.style.translate = "")));
    }
  }
</script>

<style>
  .founder {
    padding-block: var(--s-24);
    border-top: 1px solid var(--line);
    overflow: hidden;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-16);
    align-items: center;
  }

  /* Stage */
  .stage-wrap {
    display: grid;
    gap: var(--s-6);
  }
  .stage {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 460px;
    isolation: isolate;
  }
  .backdrop {
    position: absolute;
    inset: 4% 0 14%;
    display: grid;
    place-items: center;
    transition: translate 600ms var(--ease);
    z-index: 0;
  }
  .emblem {
    width: 92%;
    aspect-ratio: 1;
    opacity: 0.45;
    animation: turn 90s linear infinite;
  }
  .emblem :global(svg) {
    width: 100%;
    height: 100%;
  }
  .emblem :global(.emblem-core) {
    opacity: 0.35;
  }
  .emblem :global(.emblem-nodes circle) {
    r: 4.5;
    transform-box: fill-box;
    transform-origin: center;
    animation: blink 4s ease-in-out infinite;
  }
  .emblem :global(.emblem-nodes circle:nth-child(2n)) {
    animation-delay: -2s;
  }
  .halo {
    position: absolute;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, var(--accent-soft), transparent);
    opacity: 0.9;
  }
  .figure {
    position: absolute;
    inset: 0;
    z-index: 1;
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition: opacity 900ms var(--ease), transform 900ms var(--ease), translate 600ms var(--ease);
    pointer-events: none;
  }
  .figure :global(img) {
    /* absolutely placed so its height resolves against the fixed-ratio stage */
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    margin-inline: auto;
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: bottom;
    filter: grayscale(0.85) contrast(1.05) drop-shadow(0 18px 30px rgb(0 0 0 / 0.5));
    transition: filter 700ms var(--ease);
  }
  .stage:hover .figure :global(img) {
    filter: grayscale(0) contrast(1) drop-shadow(0 18px 30px rgb(0 0 0 / 0.5));
  }
  .stage[data-side="architect"] [data-figure="architect"],
  .stage[data-side="builder"] [data-figure="builder"] {
    opacity: 1;
    transform: none;
  }
  .floor {
    position: absolute;
    left: 15%;
    right: 15%;
    bottom: -2%;
    height: 6%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.55), transparent);
    z-index: 0;
  }
  :global(:root[data-theme="light"]) .floor {
    background: radial-gradient(closest-side, rgb(0 0 0 / 0.18), transparent);
  }

  .sides {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-3);
    max-width: 460px;
  }
  .sides button {
    display: grid;
    gap: var(--s-1);
    text-align: left;
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    cursor: pointer;
    position: relative;
    overflow: hidden;
    transition: border-color var(--dur) var(--ease), background-color var(--dur) var(--ease);
  }
  .sides button::after {
    /* a thin line marks the side on show */
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-slow) var(--ease);
  }
  .sides button[aria-pressed="true"] {
    border-color: var(--line-strong);
    background: color-mix(in srgb, var(--surface) 70%, transparent);
  }
  .sides button[aria-pressed="true"]::after {
    transform: scaleX(1);
  }
  .side-label {
    font-family: var(--font-display);
    font-weight: 600;
    color: var(--text-strong);
  }
  .side-caption {
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--text-muted);
  }

  /* Copy */
  .copy {
    display: grid;
    gap: var(--s-6);
    max-width: 44rem;
  }
  h2 {
    font-size: var(--step-3);
    font-weight: 600;
    color: var(--text-strong);
    max-width: 18ch;
  }
  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--text-strong);
  }
  .role {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .bio {
    display: grid;
    gap: var(--s-4);
    color: var(--text-muted);
  }
  .motto {
    margin: 0;
    padding-left: var(--s-6);
    border-left: 2px solid var(--accent);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-strong);
  }

  @keyframes turn {
    to {
      rotate: 360deg;
    }
  }
  @keyframes blink {
    0%,
    100% {
      fill: var(--emblem-node);
      scale: 1;
    }
    50% {
      fill: var(--emerald);
      scale: 1.3;
    }
  }
  @media (max-width: 959px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--s-12);
    }
    .stage,
    .sides {
      max-width: 380px;
      margin-inline: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .emblem,
    .emblem :global(.emblem-nodes circle) {
      animation: none;
    }
  }
</style>
