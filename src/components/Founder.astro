---
import { Image } from "astro:assets";
import portrait from "../assets/founder.jpg";
import { site } from "../data/site";
import { useTranslations, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<section class="founder" id="about" aria-labelledby="founder-title">
  <div class="container grid">
    <figure class="portrait">
      <Image src={portrait} alt={t("founder.portrait")} widths={[280, 372]} sizes="(max-width: 959px) 60vw, 300px" loading="lazy" />
    </figure>
    <div class="copy">
      <p class="eyebrow">{t("founder.eyebrow")}</p>
      <h2 id="founder-title">{t("founder.title")}</h2>
      <p class="name">
        <span>{site.founder}</span>
        <span class="role">{t("founder.role")}</span>
      </p>
      <div class="bio">
        <p>{t("founder.p1")}</p>
        <p>{t("founder.p2")}</p>
        <p>{t("founder.p3")}</p>
      </div>
      <blockquote class="motto">{t("founder.motto")}</blockquote>
    </div>
  </div>
</section>

<style>
  .founder {
    padding-block: var(--s-24);
    border-top: 1px solid var(--line);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--s-16);
    align-items: start;
  }
  .portrait {
    margin: 0;
    max-width: 300px;
  }
  .portrait :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 30% 30%;
    border-radius: var(--radius);
    filter: grayscale(0.85) contrast(1.05);
    transition: filter var(--dur-slow) var(--ease);
  }
  .portrait:hover :global(img) {
    filter: none;
  }
  .copy {
    display: grid;
    gap: var(--s-6);
    max-width: 44rem;
  }
  h2 {
    font-size: var(--step-3);
    font-weight: 600;
    color: var(--text-strong);
    max-width: 18ch;
  }
  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s-2) var(--s-4);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 600;
    color: var(--text-strong);
  }
  .role {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .bio {
    display: grid;
    gap: var(--s-4);
    color: var(--text-muted);
  }
  .motto {
    margin: 0;
    padding-left: var(--s-6);
    border-left: 2px solid var(--accent);
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.4;
    color: var(--text-strong);
  }
  @media (max-width: 959px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--s-8);
    }
    .portrait {
      max-width: 220px;
    }
  }
</style>
