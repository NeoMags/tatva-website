---
import { useTranslations, type Locale, type UIKey } from "../i18n/ui";
import { elementSVG } from "../lib/sculpture-svg";
import { PILLAR_ORDER } from "../scripts/scene/elements";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const pillars = PILLAR_ORDER.map((id, i) => ({
  id,
  index: String(i + 1).padStart(2, "0"),
  name: t(`pillars.${id}` as UIKey),
  native: t(`pillars.${id}.native` as UIKey),
  body: t(`pillars.${id}.body` as UIKey),
  element: t(`pillars.element.${id}` as UIKey),
  drawing: elementSVG(i),
}));
---

<section class="pillars" id="pillars" data-scene-pillars aria-labelledby="pillars-title">
  <div class="container">
    <header class="head">
      <p class="eyebrow">{t("pillars.eyebrow")}</p>
      <h2 id="pillars-title">{t("pillars.title")}</h2>
    </header>

    <ol class="grid">
      {
        pillars.map((p) => (
          <li class="pillar" data-pillar={p.id} tabindex="0">
            <div class="slot" data-anchor-pillar={p.id}>
              <div class="scene-fallback" set:html={p.drawing} />
            </div>
            <p class="meta">
              <span class="num">{p.index}</span>
              <span class="element">{p.element}</span>
            </p>
            <h3>
              {p.name}
              {p.native && (
                <span class="native" lang={locale}>
                  {p.native}
                </span>
              )}
            </h3>
            <p class="body">{p.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="akasha">
      <span class="node" aria-hidden="true"></span>
      {t("pillars.akasha")}
    </p>
  </div>
</section>
<div data-scene-end aria-hidden="true"></div>

<style>
  .pillars {
    padding-block: var(--s-24) var(--s-32);
  }
  .head {
    display: grid;
    gap: var(--s-4);
    max-width: 40rem;
    margin-bottom: var(--s-12);
  }
  h2 {
    font-size: var(--step-3);
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .pillar {
    display: grid;
    align-content: start;
    gap: var(--s-3);
    padding: var(--s-6) var(--s-6) var(--s-8);
    border-right: 1px solid var(--line);
    transition: background-color var(--dur) var(--ease);
    outline-offset: -2px;
  }
  .pillar:first-child {
    padding-left: 0;
  }
  .pillar:last-child {
    border-right: 0;
  }
  .pillar:hover,
  .pillar:focus-visible {
    background: color-mix(in srgb, var(--surface) 35%, transparent);
  }
  .slot {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    max-width: 180px;
    margin-bottom: var(--s-2);
  }
  .scene-fallback {
    position: absolute;
    inset: 12%;
  }
  .scene-fallback :global(svg) {
    width: 100%;
    height: 100%;
  }
  .meta {
    display: flex;
    gap: var(--s-3);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .num {
    color: var(--accent-2);
    font-variant-numeric: tabular-nums;
  }
  h3 {
    font-size: var(--step-2);
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .native {
    font-family: var(--font-body);
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--accent);
  }
  .body {
    color: var(--text-muted);
    font-size: var(--step-0);
  }
  .akasha {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-12);
    color: var(--text-muted);
    font-size: var(--step--1);
  }
  .node {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--accent-2);
    flex: none;
  }

  @media (max-width: 959px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pillar:nth-child(2) {
      border-right: 0;
    }
    .pillar:nth-child(odd) {
      padding-left: 0;
    }
    .pillar:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .slot {
      max-width: 120px;
    }
  }
  @media (max-width: 560px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .pillar {
      padding-left: 0;
      border-right: 0;
      grid-template-columns: 88px 1fr;
      column-gap: var(--s-4);
    }
    .pillar + .pillar {
      border-top: 1px solid var(--line);
    }
    .slot {
      grid-row: span 3;
      max-width: 88px;
    }
  }
</style>
