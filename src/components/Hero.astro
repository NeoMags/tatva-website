---
import { localizePath, useTranslations, type Locale } from "../i18n/ui";
import { assembledSculptureSVG } from "../lib/sculpture-svg";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const home = localizePath("/", locale);
const words = (s: string) => s.split(" ");
const line1 = words(t("hero.title.1"));
const line2 = words(t("hero.title.2"));
const fallback = assembledSculptureSVG(t("hero.sculpture.alt"));
---

<section class="hero" data-scene-hero aria-labelledby="hero-title">
  <div class="sticky">
    <div class="container grid">
      <div class="copy">
        <p class="eyebrow reveal" style="--d: 0">{t("hero.eyebrow")}</p>
        <h1 id="hero-title">
          <span class="line">
            {line1.map((w, i) => <><span class="word" style={`--d:${i + 1}`}>{w}</span>{" "}</>)}
          </span>
          <span class="line accent">
            {line2.map((w, i) => <><span class="word" style={`--d:${i + 1 + line1.length}`}>{w}</span>{" "}</>)}
          </span>
        </h1>
        <p class="lead reveal" style="--d: 8">{t("hero.lead")}</p>
        <p class="body reveal" style="--d: 9">{t("hero.body")}</p>
        <div class="ctas reveal" style="--d: 10">
          <a class="btn btn-primary" href={`${home}#work`}>
            {t("hero.cta.primary")} <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn btn-ghost" href={`${home}#contact`}>{t("hero.cta.secondary")}</a>
        </div>
      </div>

      <div class="visual" data-anchor="hero">
        <div class="scene-fallback" set:html={fallback} />
      </div>
    </div>

    <div class="container foot reveal" style="--d: 12">
      <p class="pillars-line" aria-label="Consult, Build, Automate, Scale">
        <span>Consult</span><span>Build</span><span>Automate</span><span>Scale</span>
      </p>
      <p class="scroll-hint"><span class="tick" aria-hidden="true"></span>{t("hero.scroll")}</p>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 220vh;
  }
  :global(html[data-scene="static"]) .hero {
    height: auto;
  }
  .sticky {
    position: sticky;
    top: 0;
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    padding-top: var(--header-h);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    align-items: center;
    gap: var(--s-8);
  }
  .copy {
    display: grid;
    gap: var(--s-6);
    padding-block: var(--s-8);
  }
  h1 {
    font-size: var(--step-4);
    font-weight: 700;
  }
  .line {
    display: block;
  }
  .line.accent {
    color: var(--accent);
  }
  .lead {
    font-size: var(--step-1);
    line-height: 1.45;
    max-width: 34ch;
    color: var(--text);
  }
  .body {
    color: var(--text-muted);
    max-width: 52ch;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-2);
  }
  .visual {
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    max-width: 560px;
    justify-self: end;
  }
  .scene-fallback {
    position: absolute;
    inset: 0;
  }
  .scene-fallback :global(svg) {
    width: 100%;
    height: 100%;
  }
  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-4);
    padding-block: var(--s-6);
    border-top: 1px solid var(--line);
  }
  .pillars-line {
    display: flex;
    gap: var(--s-6);
    font-family: var(--font-display);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .pillars-line span + span::before {
    content: "";
    display: inline-block;
    width: 1px;
    height: 0.9em;
    background: var(--accent-2);
    margin-right: var(--s-6);
    vertical-align: -0.1em;
  }
  .scroll-hint {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .tick {
    width: 1px;
    height: 28px;
    background: linear-gradient(var(--accent), transparent);
    animation: tick 2.2s var(--ease) infinite;
    transform-origin: top;
  }
  :global(html[data-scene="static"]) .scroll-hint {
    display: none;
  }

  /* Entrance: words rise in sequence; everything else fades up. */
  .word,
  .reveal {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.4em);
    animation: rise 900ms var(--ease) forwards;
    animation-delay: calc(var(--d) * 70ms + 150ms);
  }
  .reveal {
    display: block;
    transform: translateY(12px);
  }
  .ctas.reveal {
    display: flex;
  }
  .foot.reveal {
    display: flex;
  }
  @keyframes rise {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @keyframes tick {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  @media (max-width: 959px) {
    /* Phones: no pinning — the hero content is taller than the screen.
       The elements assemble as the sculpture scrolls into view instead. */
    .hero {
      height: auto;
    }
    .sticky {
      position: relative;
      min-height: 0;
    }
    .grid {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 0;
    }
    .copy {
      padding-block: var(--s-6) 0;
      gap: var(--s-4);
    }
    .body {
      display: none;
    }
    .visual {
      justify-self: center;
      max-width: min(78vw, 42svh);
      margin-top: var(--s-4);
    }
    .foot {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--s-2);
      padding-block: var(--s-4);
    }
    .pillars-line {
      gap: var(--s-3);
      letter-spacing: 0.14em;
      font-size: 0.75rem;
    }
    .pillars-line span + span::before {
      margin-right: var(--s-3);
    }
  }
</style>
