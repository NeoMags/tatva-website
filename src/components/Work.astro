---
import WorkList from "./WorkList.astro";
import { projects, sortedProjects } from "../data/projects";
import { useTranslations, type Locale } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const featured = sortedProjects(projects.filter((p) => p.featured));
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="container">
    <header class="head">
      <div>
        <p class="eyebrow">{t("work.eyebrow")}</p>
        <h2 id="work-title">{t("work.title")}</h2>
      </div>
      <p class="intro">{t("work.intro")}</p>
    </header>
    <WorkList projects={featured} locale={locale} />
    <p class="all">
      <a class="btn btn-ghost" href="/work/">{t("work.all")} <span class="arrow" aria-hidden="true">→</span></a>
    </p>
  </div>
</section>

<style>
  .work {
    padding-block: var(--s-24);
    background: var(--bg);
    position: relative;
  }
  .head {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
    gap: var(--s-8);
    align-items: end;
    margin-bottom: var(--s-12);
  }
  .head > div {
    display: grid;
    gap: var(--s-4);
  }
  h2 {
    font-size: var(--step-3);
    font-weight: 600;
    color: var(--text-strong);
    max-width: 18ch;
  }
  .intro {
    color: var(--text-muted);
  }
  .all {
    margin-top: var(--s-8);
  }
  @media (max-width: 959px) {
    .head {
      grid-template-columns: 1fr;
      gap: var(--s-4);
    }
  }
</style>
