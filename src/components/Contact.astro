---
import { site } from "../data/site";
import { useTranslations, type Locale, type UIKey } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const interests = [
  ...[0, 1, 2, 3, 4, 5, 6, 7].map((i) => t(`disc.${i}.title` as UIKey)),
  "Software subscription (Inspecto, Poultry, Inventory)",
  "Something else",
];
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
const wa = `https://wa.me/${site.phone.e164.replace("+", "")}`;
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container grid">
    <div class="intro">
      <p class="eyebrow">{t("contact.eyebrow")}</p>
      <h2 id="contact-title">{t("contact.title")}</h2>
      <p class="lede">{t("contact.intro")}</p>

      <div class="pricing">
        <p class="label">{t("contact.pricing.label")}</p>
        <p class="range">{t("contact.pricing.range")}</p>
        <p class="note">{t("contact.pricing.note")}</p>
      </div>

      <dl class="direct">
        <div>
          <dt>WhatsApp</dt>
          <dd><a href={wa} target="_blank" rel="noopener">{t("contact.whatsapp")}</a></dd>
        </div>
        <div>
          <dt>{t("contact.call")}</dt>
          <dd><a href={`tel:${site.phone.e164}`}>{site.phone.display}</a></dd>
        </div>
        <div>
          <dt>{t("contact.email")}</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt>{t("contact.location")}</dt>
          <dd>{site.location}</dd>
        </div>
      </dl>
    </div>

    <form class="form" data-enquiry-form action="/api/enquiry" method="post" novalidate>
      <div class="row two">
        <label class="field">
          <span>{t("form.name")}</span>
          <input id="enq-name" name="name" type="text" autocomplete="name" required maxlength="120" />
          <small class="err" data-err-for="name"></small>
        </label>
        <label class="field">
          <span>{t("form.email")}</span>
          <input id="enq-email" name="email" type="email" autocomplete="email" required maxlength="200" />
          <small class="err" data-err-for="email"></small>
        </label>
      </div>
      <div class="row two">
        <label class="field">
          <span>{t("form.phone")}</span>
          <input id="enq-phone" name="phone" type="tel" autocomplete="tel" maxlength="30" />
        </label>
        <label class="field">
          <span>{t("form.org")}</span>
          <input id="enq-org" name="organization" type="text" autocomplete="organization" maxlength="160" />
        </label>
      </div>
      <div class="row two">
        <label class="field">
          <span>{t("form.interest")}</span>
          <select id="enq-interest" name="interest" required>
            <option value="">{t("form.interest.placeholder")}</option>
            {interests.map((i) => <option value={i}>{i}</option>)}
          </select>
          <small class="err" data-err-for="interest"></small>
        </label>
        <label class="field">
          <span>{t("form.budget")}</span>
          <select id="enq-budget" name="budget">
            <option value="">{t("form.budget.placeholder")}</option>
            {site.budgets.map((b) => <option value={b}>{b}</option>)}
          </select>
        </label>
      </div>
      <label class="field">
        <span>{t("form.message")}</span>
        <textarea id="enq-message" name="message" rows="5" required minlength="20" maxlength="4000"></textarea>
        <small class="err" data-err-for="message"></small>
      </label>

      {/* Hidden from people; bots tend to fill it in. */}
      <label class="hp" aria-hidden="true">
        Website <input id="enq-website" name="website" type="text" tabindex="-1" autocomplete="off" />
      </label>

      <label class="check">
        <input id="enq-consent" name="consent" type="checkbox" required />
        <span>{t("form.consent")} <a href="/privacy/" target="_blank" rel="noopener">{t("form.privacy")}</a></span>
      </label>
      <small class="err" data-err-for="consent"></small>

      {turnstileKey && <div class="cf-turnstile" data-sitekey={turnstileKey} data-theme="auto"></div>}

      <div class="actions">
        <button class="btn btn-primary" type="submit" data-label={t("form.submit")} data-sending={t("form.sending")}>
          {t("form.submit")}
        </button>
        <p class="status" role="status" aria-live="polite" data-form-status></p>
      </div>

      <template data-messages
        data-required={t("form.required")}
        data-email={t("form.invalidEmail")}
        data-short={t("form.tooShort")}
        data-sent={t("form.sent")}
        data-error={t("form.error")}></template>
    </form>
  </div>
</section>

{turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}

<script>
  import { initEnquiryForm } from "../scripts/ui/enquiry";
  initEnquiryForm();
</script>

<style>
  .contact {
    padding-block: var(--s-24);
    border-top: 1px solid var(--line);
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--s-16);
    align-items: start;
  }
  .intro {
    display: grid;
    gap: var(--s-6);
  }
  h2 {
    font-size: var(--step-3);
    font-weight: 600;
    color: var(--text-strong);
    max-width: 14ch;
  }
  .lede {
    color: var(--text-muted);
  }
  .pricing {
    display: grid;
    gap: var(--s-1);
    padding: var(--s-6) 0;
    border-block: 1px solid var(--line);
  }
  .label {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .range {
    font-family: var(--font-display);
    font-size: var(--step-2);
    font-weight: 600;
    color: var(--text-strong);
    font-variant-numeric: tabular-nums;
  }
  .note {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .direct {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4) var(--s-6);
    margin: 0;
  }
  .direct dt {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .direct dd {
    margin: var(--s-1) 0 0;
    overflow-wrap: anywhere;
  }
  .direct a {
    color: var(--text);
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
  }
  .direct a:hover {
    color: var(--accent);
  }

  .form {
    display: grid;
    gap: var(--s-4);
    padding: var(--s-8);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .row.two {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .field {
    display: grid;
    gap: var(--s-2);
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  input,
  select,
  textarea {
    width: 100%;
    min-height: 46px;
    padding: var(--s-3) var(--s-3);
    background: var(--bg);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    color: var(--text);
    font-size: var(--step-0);
    transition: border-color var(--dur-fast) var(--ease), box-shadow var(--dur-fast) var(--ease);
  }
  textarea {
    resize: vertical;
    min-height: 130px;
  }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }
  [aria-invalid="true"] {
    border-color: #e5484d;
  }
  .err {
    min-height: 0;
    color: #ff6b6b;
    font-size: 0.8rem;
  }
  :global(:root[data-theme="light"]) .err {
    color: #c62828;
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .check {
    display: flex;
    gap: var(--s-3);
    align-items: flex-start;
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .check input {
    width: 18px;
    min-height: 18px;
    height: 18px;
    margin-top: 2px;
    accent-color: var(--accent);
    flex: none;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-4);
    margin-top: var(--s-2);
  }
  .status {
    font-size: var(--step--1);
    color: var(--text-muted);
  }
  .status[data-tone="ok"] {
    color: var(--accent);
  }
  .status[data-tone="error"] {
    color: #ff6b6b;
  }

  @media (max-width: 959px) {
    .grid {
      grid-template-columns: 1fr;
      gap: var(--s-12);
    }
  }
  @media (max-width: 560px) {
    .row.two,
    .direct {
      grid-template-columns: 1fr;
    }
    .form {
      padding: var(--s-6) var(--s-4);
    }
  }
</style>
