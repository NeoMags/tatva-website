---
/**
 * TATVA logo. `wordmark` = letters only; `lockup` = emblem + letters (header);
 * `emblem` = the tesseract emblem alone.
 * The letters are thin geometric strokes redrawn from the approved logo;
 * they use currentColor so they follow the theme.
 */
import { emblemSVG } from "../lib/emblem";

interface Props {
  variant?: "wordmark" | "lockup" | "emblem";
  class?: string;
  id?: string;
}
const { variant = "lockup", class: className, id = "logo" } = Astro.props;
const emblem = emblemSVG({ id: `${id}-emblem` });
---

<span class:list={["logo", `logo--${variant}`, className]}>
  {variant !== "wordmark" && <span class="logo-emblem" set:html={emblem} />}
  {
    variant !== "emblem" && (
      <svg class="logo-word" viewBox="-6 -6 722 112" role="img" aria-label="TATVA" xmlns="http://www.w3.org/2000/svg">
        <g fill="none" stroke="currentColor" stroke-width="12" stroke-linejoin="miter" stroke-miterlimit="10">
          <path d="M0 6H110M55 6V100" />
          <path d="M150 100L205 9L260 100" />
          <path d="M300 6H410M355 6V100" />
          <path d="M450 0L505 91L560 0" />
          <path d="M600 100L655 9L710 100" />
        </g>
      </svg>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    color: var(--text-strong);
    line-height: 1;
  }
  .logo-emblem {
    display: inline-block;
    width: 1.9em;
    height: 1.9em;
    flex: none;
  }
  .logo-emblem :global(svg) {
    width: 100%;
    height: 100%;
  }
  .logo-word {
    height: 0.9em;
    width: auto;
    aspect-ratio: 722 / 112;
  }
</style>
