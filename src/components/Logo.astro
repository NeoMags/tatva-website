---
/**
 * TATVA wordmark, redrawn as vector from the business card.
 * Letters use currentColor; the two accent strokes use the theme accent,
 * so the mark works on dark and light backgrounds.
 */
interface Props {
  class?: string;
  title?: string;
}
const { class: className, title = "TATVA" } = Astro.props;
---

<svg class={className} viewBox="0 0 1360 200" role="img" aria-label={title} xmlns="http://www.w3.org/2000/svg">
  <g fill="currentColor">
    <path d="M0 0H230V36H133V200H97V36H0Z"></path>
    <path d="M250 200L368 0H412L530 200H484L390 44L296 200Z"></path>
    <path d="M555 0H785V36H688V200H652V36H555Z"></path>
    <path d="M810 0H856L935 150L1014 0H1060L958 200H912Z"></path>
    <path d="M1080 200L1198 0H1242L1360 200H1314L1220 44L1126 200Z"></path>
  </g>
  <g fill="var(--accent)">
    <path d="M346 200H386L428 130H388Z"></path>
    <path d="M1176 200H1216L1258 130H1218Z"></path>
  </g>
</svg>
